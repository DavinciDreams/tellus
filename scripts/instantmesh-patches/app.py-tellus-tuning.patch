+def clean_white_background(image, threshold=235, chroma_limit=35):
+    rgba = image.convert("RGBA")
+    arr = np.array(rgba).astype(np.float32)
+    rgb = arr[..., :3]
+    alpha = arr[..., 3]
+
+    min_rgb = rgb.min(axis=-1)
+    max_rgb = rgb.max(axis=-1)
+    chroma = max_rgb - min_rgb
+    near_white = (min_rgb >= threshold) & (chroma <= chroma_limit)
+
+    if near_white.any():
+        softness = max(1.0, 255.0 - threshold)
+        white_fade = np.clip((255.0 - min_rgb) / softness, 0.0, 1.0)
+        alpha = np.where(near_white, np.minimum(alpha, alpha * white_fade), alpha)
+        arr[..., 3] = alpha
+
+    return Image.fromarray(np.clip(arr, 0, 255).astype(np.uint8), "RGBA")
+
