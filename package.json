{
  "name": "tellus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Tellus: a tiny AI terrarium where agents shape a floating world.",
  "engines": {
    "node": "22.x"
  },
  "trustedDependencies": [
    "procplants"
  ],
  "scripts": {
    "dev": "vite --host --port 3344 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4344",
    "start": "bun server.ts",
    "instantmesh:setup": "bash scripts/setup-instantmesh.sh",
    "instantmesh:start": "bash scripts/start-instantmesh.sh",
    "bench:instantmesh": "bun scripts/benchmark-instantmesh.mjs",
    "terrain:evoflow-variety": "node scripts/generate-evoflow-terrain-variety.mjs",
    "terrain:yosemite": "node scripts/bake-yosemite-dem.mjs --chunks=20",
    "wildlife:audit": "node scripts/audit-wildlife-pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "test:coverage": "vitest run --passWithNoTests --testTimeout=30000 --coverage",
    "perf:bundle": "bun run build && node scripts/check-entry-bundle-performance.mjs",
    "perf:render": "bun run build && node scripts/check-render-performance.mjs",
    "perf:procplants-webgl": "bun run build && node scripts/check-procplant-webgl-performance.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@vitejs/plugin-react": "^6.0.1",
    "3d-tiles-renderer": "^0.4.28",
    "cesium": "^1.143.0",
    "lucide-react": "^0.577.0",
    "meshoptimizer": "^1.1.1",
    "nostr-tools": "^2.23.5",
    "procplants": "github:DavinciDreams/procedural-plant-lab#6c073c3accd64f84d6b38d3acd6e2de470b5548e",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260605.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.183.1",
    "@vitest/coverage-v8": "4.1.0",
    "geotiff": "^3.0.5",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "4.1.0",
    "wrangler": "^4.103.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "hono": "^4.12.34",
    "ws": "^8.21.0",
    "ip-address": "^10.4.0",
    "fast-uri": "^3.1.3",
    "postcss": "^8.5.23",
    "undici": "^7.29.0",
    "body-parser": "^2.3.0",
    "@hono/node-server": "^2.0.5",
    "vite": "^8.0.16",
    "sharp": "^0.35.0"
  }
}
